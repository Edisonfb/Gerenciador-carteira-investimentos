# Configuracoes gerais da aplicacao
APP_NAME=Gerenciador de Carteiras de Investimento
APP_ENV=development

# Banco de dados MySQL
DATABASE_URL=mysql+pymysql://portfolio_user:portfolio_password@localhost:3306/investment_portfolio_manager
MYSQL_DATABASE=investment_portfolio_manager
MYSQL_USER=portfolio_user
MYSQL_PASSWORD=portfolio_password
MYSQL_ROOT_PASSWORD=root_password

# Envio de e-mail
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=
